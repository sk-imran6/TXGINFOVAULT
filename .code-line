.code-line {
  position: absolute;
  white-space: nowrap;
  color: #168cff;
  font-family: "Courier New", monospace;
  font-size: 11px;
  opacity: .65;
  animation: moveCode linear infinite;
  will-change: transform;
}

@keyframes moveCode {
  from {
    transform: translateX(115vw);
  }

  to {
    transform: translateX(-130vw);
  }
}
